# ─── APP ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://pulsepay.com.br
NEXT_PUBLIC_APP_NAME=PulsePay

# ─── NEXTAUTH ───────────────────────────────────
NEXTAUTH_SECRET=                    # gerar: openssl rand -hex 32
NEXTAUTH_URL=https://pulsepay.com.br

# ─── GOOGLE OAUTH ───────────────────────────────
GOOGLE_CLIENT_ID=                   # Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_SECRET=               # redirect URI: {NEXTAUTH_URL}/api/auth/callback/google

# ─── SUPABASE ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=           # Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Dashboard → Settings → API → anon key (pode ser pública)
SUPABASE_SERVICE_ROLE_KEY=          # Dashboard → Settings → API → service_role key (NUNCA expor)

# ─── DATABASE ───────────────────────────────────
DATABASE_URL=                       # Supabase → Settings → Database → Connection string (Prisma)
DIRECT_URL=                         # Supabase → Settings → Database → Direct connection

# ─── PAGAMENTOS (DESATIVADO por enquanto) ───────
# Integração Woovi mantida no código, porém desligada. Para RELIGAR, defina:
#   WOOVI_ENABLED=true
#   NEXT_PUBLIC_PAYMENTS_ENABLED=true
# e preencha as credenciais abaixo.
WOOVI_ENABLED=false                 # servidor: habilita geração de PIX/webhook/refund
NEXT_PUBLIC_PAYMENTS_ENABLED=false  # cliente: mostra a seção de pagamento no checkout
# WOOVI_APP_ID=                     # Woovi Dashboard → API/Plugins
# WOOVI_WEBHOOK_AUTH=               # senha definida por você para validar webhooks

# ─── EMAIL (RESEND) ─────────────────────────────
RESEND_API_KEY=                     # Resend Dashboard → API Keys (ausente = modo dry-run: loga o HTML)
EMAIL_FROM=noreply@pulsepay.com.br
ADMIN_ALERT_EMAIL=                  # destino dos alertas de segurança (audit.ts); vazio = não envia
# NEXT_PUBLIC_APP_URL (seção APP, no topo) é a base dos links dos e-mails

# ─── SEGURANÇA ──────────────────────────────────
WEBHOOK_HMAC_SECRET=                # gerar: openssl rand -hex 32
ENCRYPTION_KEY=                     # gerar: openssl rand -hex 32 (para dados sensíveis em repouso)
INTERNAL_API_SECRET=                # gerar: openssl rand -hex 32 (para rotas internas cron etc)
