generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(cuid())
  name               String
  email              String           @unique
  password           String
  role               Role             @default(USER)
  status             UserStatus       @default(PENDING)
  kycStatus          KycStatus        @default(NOT_SUBMITTED)
  document           String?
  phone              String?
  pixKey             String?
  pixKeyType         PixKeyType?
  bankName           String?
  bankAgency         String?
  bankAccount        String?
  avatarUrl          String?
  platformFeePercent Float            @default(9.99)
  totalEarnings      Float            @default(0)
  totalWithdrawn     Float            @default(0)
  availableBalance   Float            @default(0)
  pendingBalance     Float            @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  showcaseConfig     Json?
  socialLinks        Json?
  username           String?          @unique
  lastActiveAt       DateTime         @default(now())
  onboardingSteps    Json?
  twoFactorEnabled   Boolean          @default(false)
  twoFactorSecret    String?
  twoFactorMethod    TwoFactorMethod? @default(TOTP)
  trustedDevices     TrustedDevice[]
  affiliateOffers    AffiliateOffer[] @relation("AffiliateOfferOwner")
  affiliations       Affiliation[]    @relation("AffiliateUser")
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  customDomains      CustomDomain[]
  kycDocuments       KycDocument[]
  notifications      Notification[]
  orders             Order[]
  pendingBalances    PendingBalance[]
  products           Product[]
  transactions       Transaction[]
  badges             UserBadge[]
  webhooks           Webhook[]
  withdrawals        Withdrawal[]
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  content   String
  read      Boolean          @default(false)
  type      NotificationType @default(INFO)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Product {
  id              String           @id @default(cuid())
  userId          String
  name            String
  description     String?
  price           Float
  currency        String           @default("BRL")
  type            ProductType      @default(SINGLE)
  status          ProductStatus    @default(ACTIVE)
  imageUrl        String?
  checkoutConfig  Json?
  slug            String           @unique
  salesCount      Int              @default(0)
  revenue         Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  showInShowcase  Boolean          @default(true)
  affiliateOffers AffiliateOffer[]
  checkoutLinks   CheckoutLink[]
  orders          Order[]
  user            User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([slug])
}

model Order {
  id                 String           @id @default(cuid())
  userId             String
  productId          String
  buyerName          String
  buyerEmail         String
  buyerCpf           String?
  buyerPhone         String?
  buyerData          Json?
  amount             Float
  platformFee        Float
  netAmount          Float
  status             OrderStatus      @default(PENDING)
  paymentMethod      PaymentMethod
  pixQrCode          String?
  pixCopyPaste       String?
  boletoUrl          String?
  boletoBarcode      String?
  cardLastFour       String?
  cardBrand          String?
  installments       Int              @default(1)
  externalId         String?
  paidAt             DateTime?
  refundedAt         DateTime?
  isMatured          Boolean          @default(false)
  statusHistory      Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  pixBrCode          String?
  pixExpiresAt       DateTime?
  pixQrCodeUrl       String?
  wooviCorrelationId String?          @unique
  wooviEndToEndId    String?
  wooviTransactionId String?
  affiliationId      String?
  affiliationSale    AffiliationSale?
  affiliation        Affiliation?     @relation(fields: [affiliationId], references: [id])
  product            Product          @relation(fields: [productId], references: [id])
  user               User             @relation(fields: [userId], references: [id])
  pendingBalances    PendingBalance[]

  @@index([userId, status])
  @@index([createdAt])
  @@index([wooviCorrelationId])
}

model PendingBalance {
  id          String   @id @default(cuid())
  userId      String
  orderId     String
  amount      Float
  availableAt DateTime
  released    Boolean  @default(false)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([availableAt])
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  amount      Float
  status      WithdrawalStatus @default(PENDING)
  pixKey      String
  pixKeyType  PixKeyType
  processedAt DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id])
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  response   String?
  success    Boolean
  sentAt     DateTime @default(now())
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  key       String    @unique
  lastUsed  DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model KycDocument {
  id         String    @id @default(cuid())
  userId     String
  type       DocType
  fileUrl    String
  status     DocStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
}

model UserBadge {
  id       String    @id @default(cuid())
  userId   String
  badge    BadgeType
  earnedAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id])
}

model CheckoutLink {
  id        String   @id @default(cuid())
  productId String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float
  balance     Float
  description String
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id])
}

model PlatformSetting {
  id                   String   @id @default("global")
  defaultPlatformFee   Float    @default(9.99)
  withdrawalFee        Float    @default(3.50)
  withdrawalPercentFee Float    @default(5.0)
  minWithdrawalAmount  Float    @default(50.0)
  minWithdrawalDays    Int      @default(7)
  balanceRetentionDays Int      @default(30)
  maintenanceMode      Boolean  @default(false)
  maintenanceMessage   String?
  wooviProductionKey   String?
  wooviSandboxKey      String?
  emailSenderName      String   @default("PulsePay")
  emailSenderAddress   String   @default("noreply@pulsepay.com.br")
  updatedAt            DateTime @updatedAt
}

model TwoFactorToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String
  expires   DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  targetId  String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model TrustedDevice {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String
  userAgent String?
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, ipAddress])
  @@index([userId])
}

model CustomDomain {
  id        String       @id @default(cuid())
  userId    String
  domain    String       @unique
  status    DomainStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AffiliateOffer {
  id               String         @id @default(cuid())
  productId        String
  ownerId          String
  title            String
  description      String?
  commissionType   CommissionType @default(PERCENTAGE)
  commissionValue  Float
  cookieDays       Int            @default(30)
  maxAffiliates    Int?
  requiresApproval Boolean        @default(false)
  status           OfferStatus    @default(ACTIVE)
  category         String?
  tags             String[]
  imageUrl         String?
  totalAffiliates  Int            @default(0)
  totalSales       Int            @default(0)
  totalRevenue     Float          @default(0)
  conversionRate   Float          @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner            User           @relation("AffiliateOfferOwner", fields: [ownerId], references: [id])
  product          Product        @relation(fields: [productId], references: [id])
  affiliations     Affiliation[]
}

model Affiliation {
  id               String            @id @default(cuid())
  offerId          String
  affiliateId      String
  status           AffiliationStatus @default(PENDING)
  affiliateLink    String            @unique
  affiliateCode    String            @unique
  totalClicks      Int               @default(0)
  totalSales       Int               @default(0)
  totalEarned      Float             @default(0)
  pendingBalance   Float             @default(0)
  availableBalance Float             @default(0)
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  affiliate        User              @relation("AffiliateUser", fields: [affiliateId], references: [id])
  offer            AffiliateOffer    @relation(fields: [offerId], references: [id])
  sales            AffiliationSale[]
  orders           Order[]
}

model AffiliationSale {
  id            String               @id @default(cuid())
  affiliationId String
  orderId       String               @unique
  saleAmount    Float
  commission    Float
  status        SaleCommissionStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime             @default(now())
  affiliation   Affiliation          @relation(fields: [affiliationId], references: [id])
  order         Order                @relation(fields: [orderId], references: [id])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum ProductType {
  SINGLE
  SUBSCRIPTION
  INSTALLMENT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CHARGEBACK
  ABANDONED
  EXPIRED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

enum DocType {
  IDENTITY_FRONT
  IDENTITY_BACK
  SELFIE
  PROOF_OF_ADDRESS
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BadgeType {
  BADGE_10K
  BADGE_50K
  BADGE_100K
  BADGE_500K
  BADGE_1M
  BADGE_5M
}

enum TransactionType {
  SALE
  WITHDRAWAL
  REFUND
  CHARGEBACK
}

enum DomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  ERROR
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum OfferStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum AffiliationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SaleCommissionStatus {
  PENDING
  CLEARED
  PAID
  REFUNDED
}

enum TwoFactorMethod {
  TOTP
  EMAIL
}
